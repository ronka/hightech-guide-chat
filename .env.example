# Server-only purchase reporting. Never prefix these with NEXT_PUBLIC_.
# Configure the same GROW_WEBHOOK_KEY in Grow's callback URL (?key=...).
# GROW_WEBHOOK_KEY=
# META_CAPI_ACCESS_TOKEN=
# CRON_SECRET=
# Optional: use Meta Events Manager's Test Events code in staging only.
# META_TEST_EVENT_CODE=
# Explicit server opt-in. Neither provider sends when mode is unset/disabled.
# Test mode requires separate test destinations (and a Meta Test Events code).
# META_PURCHASE_MODE=disabled
# META_PIXEL_ID=
# GOOGLE_PURCHASE_MODE=disabled
# GA_PURCHASE_MEASUREMENT_ID=
# GA_MEASUREMENT_PROTOCOL_SECRET=
# Enabling Google also requires verified Grow/browser correlation and consent.
# Existing static callbacks are explicitly suppressed until that mapping exists.

# Google/Meta browser delivery is OFF unless explicitly enabled below.
# Owner-selected policy: no consent prompt; configured tags start automatically.
# Set mode to production only on your production host; test requires separate IDs.
# NEXT_PUBLIC_ANALYTICS_MODE=disabled
# NEXT_PUBLIC_ANALYTICS_HOSTNAME=hightechguide.co.il
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_FB_PIXEL_ID=
# NEXT_PUBLIC_VERCEL_ENV=production
# No banner or setTrackingConsent() call is required for normal startup.
