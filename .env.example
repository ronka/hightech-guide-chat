# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# PUBLIC_POSTHOG_HOST=
# PUBLIC_POSTHOG_KEY=
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=
